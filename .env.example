# BYOK — Anthropic key for the local dev server only (never committed).
# When set, Studio can use Claude without pasting the key into Settings (see GET /api/ai-config).
# In-app keys in Settings still work and take precedence over env.
OPENUI_AI_KEY=
ANTHROPIC_API_KEY=

# Enable Angular workspace + preview in the studio (set by npm run dev / dev:angular)
OPENUI_ANGULAR=
VITE_OPENUI_ANGULAR=

# Production static server port (server.js)
PORT=3000
